/* =========================================================
   LABORATÓRIO 1 - Verificador de idade
   ========================================================= */
const campo = document.getElementById("idade");
const saida = document.getElementById("resultado");

document.getElementById("verificar").addEventListener("click", () => {
  // 1) Lê o texto e remove espaços das pontas
  const texto = campo.value.trim();

  // 2) Campo vazio
  if (texto === "") {
    saida.textContent = "Informe a idade.";
    return;
  }

  // 3) Converte e valida (inteiro entre 0 e 120)
  const idade = Number(texto);
  if (!Number.isInteger(idade) || idade < 0 || idade > 120) {
    saida.textContent = "Idade inválida.";
    return;
  }

  // 4) Decide a resposta
  saida.textContent = idade >= 18 ? "Maior de idade" : "Menor de idade";
});

/* Testes obrigatórios:
   17 -> Menor de idade | 18 -> Maior de idade | vazio -> Informe a idade
   -2 -> Idade inválida | 18,5 -> Idade inválida */


/* =========================================================
   LABORATÓRIO 2 - Calculadora de média
   ========================================================= */
const saidaMedia = document.getElementById("resultadoMedia");

document.getElementById("calcular").addEventListener("click", () => {
  const t1 = document.getElementById("n1").value.trim();
  const t2 = document.getElementById("n2").value.trim();
  const t3 = document.getElementById("n3").value.trim();

  // Campos vazios
  if (t1 === "" || t2 === "" || t3 === "") {
    saidaMedia.textContent = "Preencha as três notas.";
    return;
  }

  // Conversão (aceita vírgula decimal, ex.: 7,5)
  const n1 = Number(t1.replace(",", "."));
  const n2 = Number(t2.replace(",", "."));
  const n3 = Number(t3.replace(",", "."));

  // Números inválidos ou fora do intervalo 0 a 10
  if (
    !Number.isFinite(n1) || !Number.isFinite(n2) || !Number.isFinite(n3) ||
    n1 < 0 || n1 > 10 || n2 < 0 || n2 > 10 || n3 < 0 || n3 > 10
  ) {
    saidaMedia.textContent = "Notas inválidas. Use valores entre 0 e 10.";
    return;
  }

  // Cálculo e classificação
  const media = (n1 + n2 + n3) / 3;

  if (media >= 6) {
    saidaMedia.textContent = "Média " + media.toFixed(2) + " - Aprovado";
  } else {
    saidaMedia.textContent = "Média " + media.toFixed(2) + " - Recuperação";
  }
});

/* Testes de fronteira: 0, 0, 0 -> 0,00 Recuperação
                        6, 6, 6 -> 6,00 Aprovado
                        10, 10, 10 -> 10,00 Aprovado */


/* =========================================================
