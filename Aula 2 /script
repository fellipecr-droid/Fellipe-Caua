   ========================================================= */

// A. Par ou ímpar usando %
const resA = document.getElementById("resA");
document.getElementById("btnA").addEventListener("click", () => {
  const texto = document.getElementById("numA").value.trim();
  if (texto === "") {
    resA.textContent = "Informe um número.";
    return;
  }
  const numero = Number(texto);
  if (!Number.isInteger(numero)) {
    resA.textContent = "Informe um número inteiro.";
    return;
  }
  if (numero % 2 === 0) {
    resA.textContent = numero + " é par.";
  } else {
    resA.textContent = numero + " é ímpar.";
  }
});

// B. Desconto de 10% para compras a partir de R$ 200
const resB = document.getElementById("resB");
document.getElementById("btnB").addEventListener("click", () => {
  const texto = document.getElementById("valorB").value.trim();
  if (texto === "") {
    resB.textContent = "Informe o valor da compra.";
    return;
  }
  const valor = Number(texto.replace(",", "."));
  if (!Number.isFinite(valor) || valor < 0) {
    resB.textContent = "Valor inválido.";
    return;
  }
  if (valor >= 200) {
    const total = valor * 0.9;
    resB.textContent = "Desconto de 10% aplicado. Total: R$ " + total.toFixed(2);
  } else {
    resB.textContent = "Sem desconto. Total: R$ " + valor.toFixed(2);
  }
});

// C. Controle de acesso com idade e cadastro ativo (&&)
const resC = document.getElementById("resC");
document.getElementById("btnC").addEventListener("click", () => {
  const texto = document.getElementById("idadeC").value.trim();
  if (texto === "") {
    resC.textContent = "Informe a idade.";
    return;
  }
  const idade = Number(texto);
  if (!Number.isInteger(idade) || idade < 0 || idade > 120) {
    resC.textContent = "Idade inválida.";
    return;
  }
  const cadastroAtivo = document.getElementById("cadastroC").checked;

  if (idade >= 18 && cadastroAtivo) {
    resC.textContent = "Acesso liberado.";
  } else if (idade < 18) {
    resC.textContent = "Acesso negado: menor de idade.";
  } else {
    resC.textContent = "Acesso negado: cadastro inativo.";
  }
});

