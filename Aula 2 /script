// E. Classificação de temperatura
const resE = document.getElementById("resE");
document.getElementById("btnE").addEventListener("click", () => {
  const texto = document.getElementById("tempE").value.trim();
  if (texto === "") {
    resE.textContent = "Informe a temperatura.";
    return;
  }
  const temp = Number(texto.replace(",", "."));
  if (!Number.isFinite(temp)) {
    resE.textContent = "Temperatura inválida.";
    return;
  }
  if (temp < 15) {
    resE.textContent = "Frio";
  } else if (temp <= 25) {
    resE.textContent = "Agradável";
  } else if (temp <= 35) {
    resE.textContent = "Quente";
  } else {
    resE.textContent = "Muito quente";
  }
});

